# Westy AI - Environment Variables Template
# Copy this file to .env.local and add your real credentials

# Google Gemini API Key (Get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Client ID for "Continue with Google" (Optional)
# Create at https://console.cloud.google.com/apis/credentials
# Set Authorized JavaScript origins to your domain (e.g., https://westy-ai.vercel.app)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Backend Server Port (defaults to 3001)
PORT=3001
